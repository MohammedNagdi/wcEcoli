# Optional local configuration. The defaults already live in docker-compose.yml.
# Copy this file to interface/.env and uncomment only the settings you need.
# The launcher works without a .env file. Exported shell values take precedence.
# Do not commit real credentials. Compose parses this file; it is not a shell script.

# SIM_RUNNER_CONCURRENCY=1
# SIM_RUNNER_CPU_BUDGET=8
# SIM_CPUS_PER_JOB=1
# PARCA_CPUS=8
# PARCA_MAX_CONCURRENCY=1
# SIM_RUNNER_MEMORY_LIMIT=0
# RUNNER_POLL_INTERVAL=1
# WORKER_LEASE_TIMEOUT=300
# WORKER_SHUTDOWN_GRACE_SEC=1800

# Optional local assistant providers (unused until configured).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=
# LM_STUDIO_BASE_URL=
# VLLM_BASE_URL=
# ASSISTANT_PROVIDER=
# ASSISTANT_MODEL=

# Optional: isolate a separate local stack. Its volumes will use this prefix.
# COMPOSE_PROJECT_NAME=my-local-stack
