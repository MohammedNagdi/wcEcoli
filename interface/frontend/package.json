{
  "name": "wcecoli-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "dev:local": "VITE_DEPLOYMENT_MODE=local vite --host 0.0.0.0",
    "dev:explorer": "VITE_DEPLOYMENT_MODE=explorer vite --host 0.0.0.0",
    "build:local": "VITE_DEPLOYMENT_MODE=local npm run build",
    "build:explorer": "VITE_DEPLOYMENT_MODE=explorer npm run build"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@xyflow/react": "^12.10.2",
    "chart.js": "^4.5.1",
    "cytoscape": "^3.28.0",
    "katex": "0.16.22",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-cytoscapejs": "^2.0.0",
    "react-dom": "^18.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "^6.22.0",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remend": "1.4.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@types/cytoscape": "^3.21.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.0",
    "vite": "^5.1.0"
  }
}
