{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@deployment/entry": [
        "src/deployment/local-entry.ts"
      ],
      "@deployment/persistence": [
        "src/deployment/persistence-local.ts"
      ],
      "@deployment/assistant": [
        "src/deployment/assistant-local.tsx"
      ],
      "@deployment/drafts": [
        "src/deployment/drafts-local.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
