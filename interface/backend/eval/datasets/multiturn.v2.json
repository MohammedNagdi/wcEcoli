              "kind": "contains",
              "value": "acetate"
            }
          ]
        },
        {
          "prompt": "Which experiment did we just queue a run for?",
          "is_probe": true,
          "assertions": [
            {
              "kind": "contains",
              "value": "acetate"
            }
          ]
        }
      ]
    },
    {
