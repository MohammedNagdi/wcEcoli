#!/usr/bin/env bash
# Transfer controller, runnable without sourcing anything first:
#
#     cluster/hfx pilot
#     cluster/hfx report
#     cluster/hfx plan && cluster/hfx dispatch
#     cluster/hfx reconcile
#     cluster/hfx status
#
# Equivalent to sourcing cluster/transfer_env.sh and running cluster/transfer.py, but
# safe to call from anywhere.

set -euo pipefail

REPO_ROOT="${WCECOLI_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
# shellcheck disable=SC1091
source "${REPO_ROOT}/cluster/transfer_env.sh" >/dev/null

exec "${WCECOLI_HF_PYTHON}" "${REPO_ROOT}/cluster/transfer.py" "$@"
