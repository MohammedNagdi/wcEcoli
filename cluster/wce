#!/usr/bin/env bash
# Campaign controller, runnable without sourcing anything first:
#
#     cluster/wce status
#     cluster/wce dispatch --limit 166
#     cluster/wce reconcile
#
# Equivalent to sourcing cluster/campaign_env.sh and running
# `python -m app.services.slurm_campaign ...`, but safe to call from anywhere.

set -euo pipefail

REPO_ROOT="${WCECOLI_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
# shellcheck disable=SC1091
source "${REPO_ROOT}/cluster/campaign_env.sh" >/dev/null

exec "${WCECOLI_API_PYTHON}" -m app.services.slurm_campaign "$@"
